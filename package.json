{
  "name": "rifttracker-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "RiftTracker - League of Legends Analytics with FastAPI and React",
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "install:frontend": "npm --prefix frontend install",
    "install:backend": "python -m pip install -r backend/requirements.txt",
    "dev:backend": "python -m uvicorn app.main:app --app-dir backend --reload --port 8000",
    "test:backend": "pytest backend/tests",
    "lint:backend": "ruff check backend"
  }
}
