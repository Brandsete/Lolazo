# RiftTracker Frontend Environment Configuration
# Optional: Set full backend URL if not using the Vite development proxy (/api)
# Default is empty string (uses Vite proxy /api -> http://127.0.0.1:8000)
# Example for direct cross-origin API calls:
# VITE_API_BASE_URL=http://127.0.0.1:8000/api
VITE_API_BASE_URL=
