# Riot Games API Configuration (Replace with your personal developer key from https://developer.riotgames.com/)
# NEVER commit real API keys into version control!
RIOT_API_KEY=RGAPI-00000000-0000-0000-0000-000000000000

# Backend Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Frontend & CORS Configuration
FRONTEND_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Application Limits
MAX_MATCHES=20

# Cache TTL Configuration (in seconds)
CACHE_TTL_SECONDS=300
CACHE_TTL_PROFILE_SECONDS=300
CACHE_TTL_LEAGUE_SECONDS=120
CACHE_TTL_MATCH_SECONDS=3600
CACHE_TTL_STATS_SECONDS=300
CACHE_MAX_ENTRIES=2000

# Riot API Client Concurrency & Resilience
RIOT_CONNECT_TIMEOUT=5.0
RIOT_READ_TIMEOUT=10.0
RIOT_MAX_CONCURRENT_REQUESTS=10
RIOT_MAX_RETRIES=2
RIOT_BACKOFF_FACTOR=0.5
RIOT_MAX_RETRY_DELAY=3.0

# In-Memory Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_ENABLED=true
